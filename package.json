{
  "name": "textree",
  "version": "0.9.0",
  "private": true,
  "description": "A local Markdown notes app: your notes stay plain files on your own disk, versioned underneath.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/textree-desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "e2e:run": "node scripts/e2e-run.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "tauri:pairs": "node scripts/check-tauri-pairs.mjs",
    "tokens:check": "tauri-kit-dev public-text --config scripts/public-text.config.mjs",
    "pins:check": "node scripts/canopy-stage.mjs && tauri-kit-dev pin-drift --props src-host/Directory.Packages.props --project src-host/src/Textree.Host/Textree.Host.csproj --properties \"RuntimeIdentifier=win-x64;SelfContained=true\" --publisher iyulab --waivers scripts/pin-drift-waivers.json",
    "host:smoke": "node scripts/host-smoke.mjs",
    "gate": "tauri-kit-dev gate --config scripts/gate.config.mjs",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "codemirror": "^6.0.2",
    "katex": "0.18.9"
  },
  "devDependencies": {
    "@iyulab/tauri-kit-dev": "^0.13.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
